# Copy this file to .env and edit. NEVER commit .env.

# --- Strategy ---
EXCHANGE=binance
SYMBOL=BTC/USDT
TIMEFRAME=1d
SHORT_WINDOW=7
LONG_WINDOW=30
INITIAL_CAPITAL=10000

# --- Runtime ---
# Seconds between checks. 3600 = hourly. Daily candles, so hourly polling is plenty.
POLL_INTERVAL=3600
# paper = simulate fills (no real orders). live = place real orders.
MODE=paper
STATE_FILE=state.json
LOG_FILE=bot.log

# --- API keys (ONLY needed for MODE=live) ---
# For Binance testnet, set EXCHANGE=binance and point ccxt at testnet in live_bot.py,
# or use EXCHANGE=binanceusdm/binancecoinm equivalents. Keep keys out of source control.
BINANCE_API_KEY=
BINANCE_API_SECRET=
